# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it is listed in .gitignore.

# ── Groq ──────────────────────────────────────────────────────────────────────
# Obtain your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Demo / fallback mode ──────────────────────────────────────────────────────
# Set to "true" to bypass the Groq API entirely and use canned responses.
# Useful during demos when the free-tier quota may be exhausted.
DEMO_MODE=false

# ── Optional: Anthropic (legacy, no longer the primary provider) ──────────────
# ANTHROPIC_API_KEY=sk-ant-your_key_here
